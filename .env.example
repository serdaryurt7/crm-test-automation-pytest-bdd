# Bu dosyayı `.env` olarak kopyalayıp kendi ortamınıza göre düzenleyin.
# `.env` .gitignore'da - gerçek kimlik bilgileri repoya girmez.
#
# Buradaki her değerin varsayılanı utils/config.py ve pages/base_page.py
# içinde tanımlı; yalnızca DEĞİŞTİRMEK istediğiniz satırları .env'e almanız
# yeterli.

# --- Uygulama adresi ---
# Login sayfasının TAM adresi (yol dahil).
BASE_URL=http://localhost:4200/login
# Uygulama kökü. Boş bırakılırsa BASE_URL'den türetilir; yalnızca
# frontend farklı bir origin'de sunuluyorsa doldurun.
# APP_ORIGIN=http://localhost:4200

# --- Test kullanıcısı ---
# UYARI: gerçek bir ortamda (staging/CI) bunlar secret olarak
# enjekte edilmeli, dosyaya yazılmamalıdır.
CRM_USERNAME=demo
CRM_PASSWORD=Password123

# --- Tarayıcı ---
# chrome | firefox | edge
BROWSER=chrome
HEADLESS=false

# --- Beklemeler (saniye) ---
# Yavaş bir makinede/CI'da bu ikisini yükseltmek, 13 sayfa dosyasına
# dokunmadan tüm beklemeleri etkiler.
DEFAULT_TIMEOUT=10
SLOW_TIMEOUT=30
